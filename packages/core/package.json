{
  "name": "@zenithfoundry/tech-lead-stack",
  "version": "1.2.1",
  "description": "MCP server for the Tech-Lead Stack: agent skills and workflows for tech leads, PMs and HR.",
  "license": "MIT",
  "author": "bronz3beard",
  "homepage": "https://github.com/bronz3beard/ai.tech-lead-stack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bronz3beard/ai.tech-lead-stack.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/bronz3beard/ai.tech-lead-stack/issues"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./ai/*": "./src/lib/ai/*.ts",
    "./skills": "./src/lib/skills/index.ts",
    "./skills/*": "./src/lib/skills/*.ts",
    "./ki/*": "./src/lib/ki/*.ts",
    "./db": "./src/lib/prisma.ts",
    "./crypto": "./src/lib/crypto.ts",
    "./telemetry-service": "./src/lib/telemetry-service.ts",
    "./trace-utils": "./src/lib/trace-utils.ts",
    "./mcp-server/*": "./src/mcp-server/*.ts"
  },
  "scripts": {
    "mcp:build": "node scripts/build-mcp-server.mjs",
    "mcp:start": "node dist/mcp-server.mjs",
    "reflexion": "tsx scripts/reflexion-loop.ts",
    "reflexion:eval": "tsx scripts/reflexion-eval.ts",
    "generate:registry": "tsx scripts/generate-skill-registry.ts",
    "index:build": "tsx scripts/build-index.ts",
    "index:update": "tsx scripts/build-index.ts",
    "calibrate-skill-costs": "tsx scripts/calibrate-skill-costs.ts",
    "db:generate": "prisma generate",
    "check-types": "tsc --noEmit --skipLibCheck",
    "test": "jest",
    "postinstall": "prisma generate",
    "prepare": "pnpm run mcp:build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/google": "^4.0.87",
    "@ai-sdk/openai": "^4.0.83",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "adm-zip": "^0.6.1",
    "ai": "7.0.127",
    "dotenv": "^16.5.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.4.2",
    "octokit": "^5.0.5",
    "p-map": "^7.0.8",
    "pg": "^8.23.1",
    "prisma": "^7.10.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2"
  }
}
