# ==========================================
# CORE ENVIRONMENT VARIABLES
# Required by @zenithfoundry/tech-lead-stack
# ==========================================

# Prisma requires a valid Postgres database connection string. This value
# matches the local database in docker-compose.yml (`docker compose up -d db`).
# The web app and the MCP server must use the same database for usage metrics
# to show up in the dashboard. Installed with npx instead of cloning? Put
# DATABASE_URL and your keys in ~/.tech-lead-stack/.env.
DATABASE_URL="postgresql://postgres:password@localhost:5432/agent_dashboard?schema=public"

# Database TLS. Managed hosts (Neon, Railway, Supabase) and any non-local host
# in production connect over TLS and the server certificate is VERIFIED.
# Local Postgres (docker-compose, localhost) uses no TLS and needs none of this.
#
# DATABASE_SSL_MODE (libpq names):
#   verify-full  default: trusted CA chain AND hostname match (Neon: nothing to set)
#   verify-ca    trusted CA chain only; requires DATABASE_SSL_CA. Use for Railway,
#                whose cert is issued to "localhost", not the *.proxy.rlwy.net host.
#   no-verify    encrypted but unauthenticated (MITM-able); logs a warning.
#
# DATABASE_SSL_CA: the provider's CA certificate. Only the
# -----BEGIN CERTIFICATE----- ... -----END CERTIFICATE----- block(s) are used,
# so pasting a whole file (text dump included) is fine, as is a single line with
# literal \n escapes. Railway: inside the Postgres service (railway ssh), print a
# ready-to-paste single line with
#   openssl x509 -in /var/lib/postgresql/data/certs/root.crt | awk '{printf "%s\\n", $0}'
# It rotates when Railway renews the server cert (820-day default); update it then.
# DATABASE_SSL_MODE="verify-ca"
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----"

# AI Provider Keys. ANTHROPIC_API_KEY + GEMINI_API_KEY together turn on the
# two-model reflexion loop (the "byo" tier). Keys saved in the web app's
# /settings page are used first; these are the fallback.
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"
GEMINI_API_KEY="your-gemini-api-key"
# GOOGLE_GENERATIVE_AI_API_KEY="..."  # accepted in place of GEMINI_API_KEY
# JULES_API_KEY="..."                 # only when a model is routed to Google Jules
# Set to "env" to use the keys above before any key saved in /settings.
# GEMINI_API_KEY_PRECEDENCE="env"

# Who usage metrics are recorded against. The MCP server asks the GitHub CLI
# (gh) first, then your global git user.email; this is the last fallback.
# USER_EMAIL="you@example.com"

# Langfuse tracing (optional; leave unset to record runs in Postgres only).
# TLS_-prefixed on purpose: a gateway that spawns this stack (see Topology 2
# below) passes its own env down, and a generic LANGFUSE_* var from the gateway
# would otherwise send TLS traces into the gateway's project as duplicates.
# Traces are written with environment "tls" and tag "source:tls".
# Renamed from LANGFUSE_* (breaking); see CHANGELOG.md for the migration.
TLS_LANGFUSE_PUBLIC_KEY="pk-lf-..."
TLS_LANGFUSE_SECRET_KEY="sk-lf-..."
TLS_LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"

# ==========================================
# LOCAL TIER & TUNING (all optional)
# See docs/configuration.md and docs/tiers.md
# ==========================================

# Fully offline "local" tier: any OpenAI-compatible model server, e.g. Ollama.
# LOCAL_MODEL_ENDPOINT="http://localhost:11434/v1"
# LOCAL_MODEL_NAME="qwen2.5-coder:7b"
# LOCAL_MODEL_CLASS="small"            # small (<10B) | mid (10-35B) | large (>35B)
# REFLEXION_MAX_WALLCLOCK_MS="600000"  # time limit for a local reflexion run

# Reflexion loop limits.
# REFLEXION_COMPACT_AT_TOKENS="8000"   # compact the loop's history past this size
# REFLEXION_MAX_COST_USD="3"           # GitHub issue runner only
# REFLEXION_MAX_REVISIONS="3"          # GitHub issue runner only

# Model routing is set in the web app (/settings and per project). Leave these
# unset so the web app stays the source of truth; they are a headless override.
# MODEL_PLANNER=""
# MODEL_IMPLEMENTER=""
# MODEL_AUDITOR=""
# MODEL_ADJUDICATOR=""

# Semantic code search (code_search tool) embeddings via Ollama.
# OLLAMA_URL="http://localhost:11434/api/embeddings"
# EMBED_MODEL="nomic-embed-text"

# Where the MCP server finds .ai/skills. Only needed when it cannot find them
# by itself. REPO_ROOT is the older name and still works.
# TECH_LEAD_STACK_ROOT="/abs/path/to/tech-lead-stack"

# Chrome profile used by the Playwright ClickUp and evidence-upload scripts.
# CHROME_PROFILE_PATH="/Users/you/Library/Application Support/Google/Chrome"

# ==========================================
# MCP SERVER & UPSTREAM PROXY
# Optional. Only relevant to how clients REACH this stack.
# ==========================================
#
# This stack's MCP server is a standalone artifact (dist/mcp-server.mjs), so a
# client can reach it in one of two topologies.
#
# ---- Topology 1: DIRECT (the default) ----
#
# The client launches this stack itself. Nothing in this section applies, and
# no variables here need setting. Tools appear to the agent as:
#
#     mcp__tech-lead-stack__get_skills
#
# ---- Topology 2: BEHIND AN UPSTREAM PROXY ----
#
# A gateway process is registered with the client instead, and forwards tool
# calls downstream to this stack. The client never sees a server named
# "tech-lead-stack": this stack's tools are re-exported under the PROXY's name.
# With a proxy registered as `slm-gate`, the same tool is:
#
#     mcp__slm-gate__get_skills
#
# THIS IS NOT SPECIFIC TO slm-gate. Any gateway that spawns or forwards to
# dist/mcp-server.mjs behaves identically — only the registered name changes.
# slm-gate is used as the worked example below because it is the reference
# implementation, not because it is required.
#
# Nothing has to be configured HERE for a proxy to work: the proxy's config
# lives in the PROXY, and the client's MCP registration lives in the client
# (~/.claude.json for Claude Code). The variables below exist so a proxy setup
# can be described in one place and reproduced.

# The name the CLIENT has the server registered under — i.e. the `<name>` in
# mcp__<name>__get_skills. Leave unset for a direct install.
#
# install.sh auto-detects this: it scans the client's registered MCP servers
# for one whose definition mentions this checkout's path, and names that server
# in the generated slash commands. Set this only to override the detection, or
# when generating commands by hand.
#
# IMPORTANT: install.sh is a shell script and does NOT read this file. Setting
# it here documents your topology; to make it take effect, either export it or
# pass the flag:
#
#     MCP_SERVER_NAME=slm-gate ./install.sh --link --ide-only
#     ./install.sh --link --ide-only --mcp-name slm-gate
#
# Either form marks the name as deliberately chosen and disables detection.
#
# Direct:          (leave unset — defaults to tech-lead-stack)
# Behind slm-gate: slm-gate
# MCP_SERVER_NAME="slm-gate"

# ---- Reference: registering slm-gate as the proxy for this stack ----
#
# This is CLIENT config (~/.claude.json), reproduced here as documentation. The
# gate is the registered server; this stack is named only inside DOWNSTREAM_MCP,
# which is what install.sh matches on to detect the proxy:
#
#   {
#     "mcpServers": {
#       "slm-gate": {
#         "command": "node",
#         "args": ["/abs/path/to/small-language-model-gate/dist/mcp-gate/index.js"],
#         "env": {
#           "TLS_ADAPTER": "on",
#           "DOWNSTREAM_MCP": "{\"command\":\"node\",\"args\":[\"/abs/path/to/tech-lead-stack/dist/mcp-server.mjs\"]}"
#         }
#       }
#     }
#   }
#
# Any other proxy substitutes its own command and its own way of naming the
# downstream target; the detection rule is the same, because it matches on this
# checkout's path appearing anywhere in the server definition.
#
# After changing which proxy fronts the stack, regenerate the slash commands so
# they name the right tool, then restart every MCP client:
#
#   ./install.sh --link --ide-only --ide claude-code
#
# ==========================================
# DASHBOARD ENVIRONMENT VARIABLES
# Required by apps/dashboard
# ==========================================

# NextAuth Configuration. Create a secret with: openssl rand -base64 32
# (AUTH_SECRET is accepted in place of NEXTAUTH_SECRET.)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key"

# Encrypts the API keys people save in /settings. Required to save keys.
# Exactly 64 hex characters. Create one with: openssl rand -hex 32
# Keep it: changing it makes keys saved earlier unreadable.
ENCRYPTION_KEY=""

# GitHub OAuth App for Login (optional: email + password sign-up also works)
GITHUB_ID="your-github-oauth-client-id"
GITHUB_SECRET="your-github-oauth-client-secret"

# Who can sign up and who is an admin. Comma-separated.
# ALLOWED_DOMAINS="example.com"        # empty = any email domain can register
# SUPER_ADMIN="you@example.com"        # sees every project

# Discord channel for web app notifications (optional).
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# ---- Optional: preview web pages in /chat ----
# WHAT: answers in the web app's /chat page sometimes include a small web page
#   written as code. The show-it skill does this for charts and labelled
#   diagrams. With this setting on, a "Preview" button appears above that code
#   so you can see the page itself. A "Source" button switches back to the code.
# WHY IT'S OFF BY DEFAULT: the page is written by an AI, so it is shown inside a
#   locked box. It cannot run programs, cannot load anything from the internet,
#   and cannot see or touch the rest of the web app. Even so, it only turns on
#   when you choose. Left off, nothing changes: you see the code, as before.
# HOW TO TURN IT ON: delete the "#" at the start of the last line below, then
#   restart the web app (stop it, then run pnpm web:dev again). On a hosting
#   service, add the same setting there and redeploy. A restart or redeploy is
#   required: the app reads this setting only while it starts up or is built.
# It is not a secret. The only values are "true" (on) and anything else (off).
# Full guide: docs/web-app.md, section "Optional: preview web pages in the chat".
# NEXT_PUBLIC_CHAT_HTML_PREVIEW="true"
