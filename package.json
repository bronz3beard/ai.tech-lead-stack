{
  "name": "tech-lead-stack-workspace",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "RTK-powered agent skills for Tech Leads.",
  "bin": {
    "lead-init": "./install.sh",
    "lead-run": "./scripts/rtk-run.sh",
    "tech-lead-clean": "./scripts/cleanup.sh"
  },
  "rtk": {
    "tools": {
      "accessibility-auditor": "cat .ai/skills/accessibility-auditor.md",
      "changelog-generator": "cat .ai/skills/changelog-generator.md",
      "clean-code": "cat .ai/skills/clean-code.md",
      "cleanup": "bash scripts/cleanup.sh",
      "code-review-checklist": "cat .ai/skills/code-review-checklist.md",
      "codebase-onboarding-intelligence": "cat .ai/skills/codebase-onboarding-intelligence.md",
      "create-pr": "bash scripts/gh-pr-create.sh",
      "daily-standup": "cat .ai/skills/daily-standup.md",
      "eval": "node scripts/autoeval-check.mjs",
      "feature-design-assistant": "cat .ai/skills/feature-design-assistant.md",
      "feature-orchestrator": "cat .ai/skills/feature-orchestrator.md",
      "mission-architect": "cat .ai/skills/mission-architect.md",
      "planning-expert": "cat .ai/skills/planning-expert.md",
      "pr-automator": "cat .ai/skills/pr-automator.md",
      "product-strategist": "cat .ai/skills/product-strategist.md",
      "reflexion-loop": "npx tsx scripts/reflexion-loop.ts",
      "regression-bug-fix": "cat .ai/skills/regression-bug-fix.md",
      "security-audit": "cat .ai/skills/security-audit.md",
      "solutioning-facilitator": "cat .ai/skills/solutioning-facilitator.md",
      "style-logic-exporter": "cat .ai/skills/style-logic-exporter.md",
      "technical-debt-auditor": "cat .ai/skills/technical-debt-auditor.md",
      "validate-scripts": "bash scripts/validate-scripts.sh",
      "validate-skills": "bash scripts/validate-skills.sh",
      "publish-evidence": "node scripts/publish-evidence.mjs",
      "verify-evidence": "node scripts/verify-evidence.mjs",
      "pr-body-inject": "node scripts/pr-body-inject.mjs",
      "resolve-labels": "node scripts/resolve-labels.mjs",
      "visual-verifier": "node scripts/visual-verifier.mjs",
      "weekly-leadership-report": "cat .ai/skills/weekly-leadership-report.md",
      "vertical-slice": {
        "skill": "vertical-slice-decomposer",
        "description": "Decompose stories into vertical slices"
      },
      "dev-team-sub-max": {
        "skill": "dev-team-sub-max",
        "description": "Subscription-tier ($100/mo) dev team orchestrator"
      },
      "dev-team-sub-pro": {
        "skill": "dev-team-sub-pro",
        "description": "Subscription-tier ($20/mo) dev pair orchestrator"
      },
      "reflexion-loop-sub-max": {
        "skill": "reflexion-loop-sub-max",
        "description": "$100/mo tier context-isolated loop"
      },
      "reflexion-loop-sub-pro": {
        "skill": "reflexion-loop-sub-pro",
        "description": "$20/mo tier context-isolated loop"
      },
      "reflexion-eval": "npm run reflexion:eval"
    }
  },
  "scripts": {
    "generate:registry": "pnpm --filter @zenithfoundry/tech-lead-stack run generate:registry",
    "test": "pnpm -r test",
    "test:gherkin": "node --test scripts/__tests__/validate-gherkin.test.mjs",
    "setup-browsers": "npx playwright install chromium",
    "postinstall": "pnpm --filter @zenithfoundry/tech-lead-stack run db:generate",
    "format": "npx prettier --write \".ai/skills/*.md\" \"scripts/*.{js,mjs}\" \"README.md\"",
    "format:check": "npx prettier --check \".ai/skills/*.md\" \"scripts/*.{js,mjs}\" \"README.md\"",
    "lint": "npx markdownlint-cli \".ai/skills/*.md\"",
    "lint:fix": "npx markdownlint-cli --fix \".ai/skills/*.md\" && npm run format",
    "validate:skills": "bash scripts/validate-skills.sh",
    "validate:gherkin": "node scripts/validate-gherkin.mjs",
    "validate:scripts": "bash scripts/validate-scripts.sh",
    "prepare": "husky",
    "mcp:build": "pnpm --filter @zenithfoundry/tech-lead-stack run mcp:build && mkdir -p dist && printf \"import '../packages/core/dist/mcp-server.mjs';\\n\" > dist/mcp-server.mjs",
    "mcp:start": "node dist/mcp-server.mjs",
    "reflexion": "pnpm --filter @zenithfoundry/tech-lead-stack run reflexion",
    "build": "pnpm -r build",
    "check-types": "pnpm -r check-types",
    "reflexion:eval": "pnpm --filter @zenithfoundry/tech-lead-stack run reflexion:eval",
    "calibrate-skill-costs": "pnpm --filter @zenithfoundry/tech-lead-stack run calibrate-skill-costs",
    "db:generate": "pnpm --filter @zenithfoundry/tech-lead-stack run db:generate"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@types/bcryptjs": "^3.0.0",
    "@types/pg": "^8.20.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "adm-zip": "^0.5.17",
    "autoevals": "latest",
    "dotenv": "^16.5.0",
    "p-map": "^7.0.4",
    "playwright-extra": "latest",
    "postcss": "^8.5.9",
    "puppeteer-extra-plugin-stealth": "latest",
    "rechart": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/adm-zip": "^0.5.8",
    "@types/dompurify": "^3.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.25.0",
    "eslint": "^9.16.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "langfuse": "^3.38.20",
    "lint-staged": "^16.4.0",
    "markdownlint-cli": "^0.48.0",
    "playwright": "latest",
    "prettier": "^3.8.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.0.0"
  },
  "keywords": [
    "agentic-dev-team",
    "ai-developer",
    "agent",
    "tech-lead",
    "automation",
    "rtk",
    "minimumcd",
    "agent-skills",
    "ai-agents",
    "mcp",
    "mcp-server",
    "cursor",
    "antigravity",
    "continue",
    "claude-skills",
    "gemini",
    "agentic-workflows",
    "trunk-based-development",
    "code-review",
    "engineering-management"
  ],
  "author": "bronz3beard",
  "license": "MIT",
  "lint-staged": {
    ".ai/skills/*.md": [
      "bash scripts/validate-skills.sh",
      "npx markdownlint-cli --fix",
      "npx prettier --write"
    ],
    "scripts/*": [
      "bash scripts/validate-scripts.sh"
    ],
    "scripts/*.{js,mjs}": [
      "npx prettier --write"
    ],
    "defect-library/**/*.md": [
      "npx markdownlint-cli --fix",
      "npx prettier --write"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "autoevals",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}